// WOFF2 web fonts for the font tiles (Typography System, T1). One subset file
// per font weight — Latin + Turkish letters, digits, punctuation — with variable
// axes pinned to the registry's values, plus one @font-face stylesheet. Nothing
// loads these yet; the picker (T6) will, lazily.
//
// Features kept: the ones browsers and HarfBuzz apply by default (so default
// shaping is unchanged) plus the registry's always-on ones (lnum). Swashes,
// stylistic sets and alternates are never on unless asked for; dropping them
// is what keeps the script faces small. Every subset is checked: it must shape
// the sample texts like the full font: same glyphs and advances, outline
// points within 1 font unit (a pinned instance rounds the variable font's
// fractional coordinates to whole units — under 0.1% of the em).
//   npx tsx scripts/typography/build-webfonts.mts
import fs from "node:fs";
import path from "node:path";
import subsetFont from "subset-font";
import * as hb from "harfbuzzjs";
import * as reg from "../../lib/typography/registry.ts";

const { FONTS, fontVariants, cssFamily, webFontFile } = ((reg as unknown as { default?: typeof reg }).default ?? reg);
const ROOT = path.resolve(import.meta.dirname, "../..");
const OUT = path.join(ROOT, "public/fonts/typography");
const TEXT = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzÇĞİÖŞÜçğıöşüÄËÏÖÜäëïöüÂÊÎÔÛâêîôûÀÈÌÒÙàèìòùÁÉÍÓÚáéíóúÑñ0123456789 &'’‘\"“”-–—.,:;!?()/@#+*%";
const DEFAULT_ON = ["abvm", "blwm", "ccmp", "locl", "mark", "mkmk", "rlig", "calt", "clig", "curs", "dist", "kern", "liga", "rclt", "init", "medi", "fina", "isol", "rvrn"];
const SAMPLES = ["Happy 1st Birthday", "Layla", "Ayşe Gül", "Malek", "İyi ki doğdun Çağla", "Mehmet Ali & Leo", "Let's Party!", "2nd 3rd 21st"];
const BUDGET_KB = 45;

fs.mkdirSync(OUT, { recursive: true });
const css: string[] = ["/* GENERATED by scripts/typography/build-webfonts.mts — do not edit by hand. Fonts: SIL OFL 1.1 (see assets/fonts/<dir>/OFL.txt). */"];
const rows: string[] = [];
const failures: string[] = [];
const sizes: number[] = [];
for (const f of FONTS) {
  for (const v of fontVariants(f)) {
    const w = v.weight;
    const src = fs.readFileSync(path.join(ROOT, "assets/fonts", f.dir, w.file));
    const face = new hb.Face(new hb.Blob(src));
    const info = face.getAxisInfos();
    const axes: Record<string, number> = {};
    for (const [tag, a] of Object.entries(info)) {
      const val = v.axes[tag];
      axes[tag] = val === undefined ? a.default : val === "max" ? a.max : val;
    }
    const always = f.features ?? [];
    const opts = {
      ...(Object.keys(axes).length ? { variationAxes: axes } : {}),
      preserveNameIds: [0, 1, 2, 3, 4, 5, 6, 13, 14],
      keepFeatures: [...DEFAULT_ON, ...always],
    };
    const woff2 = await subsetFont(src, TEXT, { ...opts, targetFormat: "woff2" });
    const sfnt = await subsetFont(src, TEXT, { ...opts, targetFormat: "sfnt" }); // HarfBuzz cannot read WOFF2: checked as sfnt
    const name = webFontFile(v);
    fs.writeFileSync(path.join(OUT, name), woff2);
    const full = new hb.Font(face);
    if (Object.keys(axes).length) full.setVariations(Object.entries(axes).map(([t2, v]) => new hb.Variation(t2, v)));
    const sub = new hb.Font(new hb.Face(new hb.Blob(sfnt)));
    const feats = always.map((t2) => new hb.Feature(t2, 1));
    const run = (font: hb.Font, s: string) => { const b = new hb.Buffer(); b.addText(s); b.guessSegmentProperties(); hb.shape(font, b, feats); const pos = b.getGlyphPositions(); return { n: b.getLength(), adv: pos.reduce((a, q) => a + q.xAdvance, 0), paths: b.getGlyphInfos().map((g) => (font.glyphToPath(g.codepoint).match(/-?d+(.d+)?/g) ?? []).map(Number)) }; };
    const bad = SAMPLES.filter((s) => { const a = run(full, s), b2 = run(sub, s); return a.n !== b2.n || Math.abs(a.adv - b2.adv) > 1 || a.paths.some((pts, i) => pts.length !== b2.paths[i].length || pts.some((v, j) => Math.abs(v - b2.paths[i][j]) > 1)); });
    if (bad.length) failures.push(`${name}: ${bad.join(" | ")}`);
    const kept = new hb.Face(new hb.Blob(sfnt)).getTableFeatureTags("GSUB").concat(new hb.Face(new hb.Blob(sfnt)).getTableFeatureTags("GPOS"));
    const kb = woff2.length / 1024;
    sizes.push(kb);
    rows.push(`${name.padEnd(30)} ${kb.toFixed(1).padStart(6)} KB ${kb > BUDGET_KB ? "over target" : "           "}  shaping ${bad.length ? "DIFFERS" : "identical"}  features: ${[...new Set(kept)].join(",")}`);
    css.push(`@font-face{font-family:"${cssFamily(v)}";src:url("/fonts/typography/${name}") format("woff2");font-weight:${w.weight};font-style:normal;font-display:swap;}`);
  }
}
fs.writeFileSync(path.join(OUT, "fonts.css"), css.join("\n") + "\n");
console.log(rows.join("\n"));
console.log(`\n${sizes.length} files, total ${sizes.reduce((a, b) => a + b, 0).toFixed(0)} KB, largest ${Math.max(...sizes).toFixed(1)} KB, over the ${BUDGET_KB} KB target: ${sizes.filter((k) => k > BUDGET_KB).length}`);
if (failures.length) { console.error("SHAPING DIFFERS:\n" + failures.join("\n")); process.exit(1); }
